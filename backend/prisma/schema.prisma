generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// Still plain SQLite - Turso speaks the libSQL wire protocol, which is
// SQLite-compatible, so the schema/provider don't change at all. Only the
// runtime connection (see src/db/prisma.ts) differs: a driver adapter talks
// to Turso in production, while local dev keeps using this file directly.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum type support in Prisma - "ADMIN"/"STAFF",
// "PICKUP"/"DELIVERY", and the order-status values below are now plain
// strings, validated at the application layer (zod schemas / VALID_STATUSES)
// instead of the database layer.
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())

  @@map("users")
}

model Customer {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  phone        String?
  createdAt    DateTime @default(now())

  addresses Address[]
  orders    Order[]

  @@map("customers")
}

model Address {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String
  address    String
  apartment  String?
  city       String
  postalCode String
  createdAt  DateTime @default(now())

  orders Order[]

  @@map("addresses")
  @@index([customerId])
}

model Category {
  id          String     @id @default(uuid())
  name        String
  description String?
  slug        String     @unique
  sortOrder   Int        @default(0)
  active      Boolean    @default(true)
  menuItems   MenuItem[]

  @@map("categories")
}

model MenuItem {
  id          String   @id @default(uuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  image       String?
  active      Boolean  @default(true)
  isPizza     Boolean  @default(false)
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sizes      ProductSize[]
  orderItems OrderItem[]

  @@map("menu_items")
}

model ProductSize {
  id         String   @id @default(uuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  price      Decimal
  sortOrder  Int      @default(0)

  @@map("product_sizes")
}

model Topping {
  id        String  @id @default(uuid())
  name      String  @unique
  price     Decimal
  premium   Boolean @default(false)
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  @@map("toppings")
}

model Deal {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal
  image       String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("deals")
}

// SQLite has no server-side sequence like Postgres' nextval() - a single
// counter row, incremented atomically inside the same order-creation
// transaction, gives the same "always-unique, always-increasing" guarantee.
model TicketCounter {
  id    Int @id @default(1)
  value Int @default(10000)

  @@map("ticket_counter")
}

model Order {
  id             String      @id @default(uuid())
  ticketNumber   String      @unique
  customerName   String
  phone          String
  email          String?
  orderType      String
  address        String?
  apartment      String?
  city           String?
  postalCode     String?
  deliveryNotes  String?
  isAsap         Boolean     @default(true)
  requestedTime  DateTime
  subtotal       Decimal
  deliveryFee    Decimal     @default(0)
  total          Decimal
  status         String      @default("NEW")
  notes          String?
  customerEmailSentAt   DateTime?
  restaurantEmailSentAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  addressId    String?
  savedAddress Address?  @relation(fields: [addressId], references: [id], onDelete: SetNull)

  items OrderItem[]

  @@map("orders")
  @@index([status])
  @@index([createdAt])
  @@index([phone])
  @@index([customerId])
}

model OrderItem {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId    String?
  menuItem      MenuItem? @relation(fields: [menuItemId], references: [id])
  nameSnapshot  String
  quantity      Int
  size          String?
  basePrice     Decimal
  customization String?
  price         Decimal

  @@map("order_items")
}
