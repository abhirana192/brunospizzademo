# ── Server ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# URL of the frontend, used for CORS + cookie settings
FRONTEND_URL=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────
# SQLite file, relative to prisma/schema.prisma - no separate DB server needed.
DATABASE_URL="file:./dev.db"
# Production only: set BOTH to connect to a hosted Turso (libSQL) database
# instead of the local file above, so data survives redeploys/restarts on
# hosts without a persistent disk (e.g. Render's free tier). Leave both
# blank for local dev. Get these from `turso db show <name>` and
# `turso db tokens create <name>` after creating a database at turso.tech.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Auth ──────────────────────────────────────────────────────────────────
# Long random string used to sign admin session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=8h
# Credentials used by `npm run create-admin` to seed the first admin account.
ADMIN_EMAIL=admin@brunopizza.com
ADMIN_PASSWORD=change_this_password
ADMIN_NAME=Bruno Pizza Admin

# ── Email (SMTP) ──────────────────────────────────────────────────────────
# Leave EMAIL_HOST empty during local development: the email service will
# log full email content to the console instead of sending, so you can
# verify order notifications without a real inbox.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Bruno Pizza <no-reply@brunopizza.com>"
# The restaurant's own inbox — receives a "NEW ORDER" email for every order.
RESTAURANT_EMAIL=orders@brunopizza.com

# ── Business rules ────────────────────────────────────────────────────────
DELIVERY_FEE=4.99
FREE_DELIVERY_THRESHOLD=35
# Restaurant hours, used to validate scheduled order times. Bruno's is open
# late: Mon-Sat 10am-3am (next day), Sun 10am-1am (next day). Close hours are
# hour-of-day + 24 to represent "next day" (e.g. 27 = 3:00 AM).
OPEN_HOUR=10
CLOSE_HOUR_MON_TO_SAT=27
CLOSE_HOUR_SUN=25
# Pizza topping fees: standard toppings charged per pizza size; premium
# toppings (specialty meats) are a flat add-on regardless of size.
PIZZA_TOPPING_FEE_SMALL=2.00
PIZZA_TOPPING_FEE_MEDIUM=2.00
PIZZA_TOPPING_FEE_LARGE=2.50
PIZZA_PREMIUM_TOPPING_FEE=7.00
